# RecoverAI Environment Configuration

# Server Port
PORT=3000

# Database Configuration (SQLite file path)
DATABASE_URL=./data/recoverai.db

# LLM Provider Configuration
# Options: "mock" (default, deterministic rule-informed mock for bench/demo), "openai", "gemini", "anthropic"
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Razorpay Test Mode Credentials (Optional: Simulator is used if omitted)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Merchant Recovery Guardrail Defaults
MAX_RECOVERY_ATTEMPTS=3
AUTONOMOUS_AMOUNT_THRESHOLD_INR=5000000 # In paise (e.g. 50,000 INR = 5,000,000 paise)
POLICY_VERSION=1.0.0
